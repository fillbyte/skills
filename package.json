{
  "name": "fillbyte-skills-workspace",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Open-source agent skills, Codex plugins, MCP servers, and developer tools for the full software lifecycle.",
  "license": "MIT",
  "author": "Fillbyte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fillbyte/skills.git"
  },
  "bugs": {
    "url": "https://github.com/fillbyte/skills/issues"
  },
  "homepage": "https://github.com/fillbyte/skills#readme",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "apple",
    "apple-platform",
    "automation",
    "codex",
    "developer-experience",
    "developer-tools",
    "ios",
    "mcp",
    "open-source",
    "plugins",
    "software-engineering",
    "skills",
    "testing",
    "xcode"
  ],
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run validate:release-metadata && npm run validate:submission && npm run lint && npm run typecheck && npm run validate:registry",
    "format": "prettier --write . && npm run format:release-metadata",
    "format:check": "prettier --check .",
    "format:release-metadata": "node scripts/validate-release-metadata.mjs --write",
    "lint": "eslint . --max-warnings 0",
    "release:sbom": "node scripts/generate-release-sbom.mjs",
    "smoke:mcp": "npm run smoke:mcp --workspaces --if-present",
    "smoke:skills": "npm run smoke:skills --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:plugin": "npm run validate:plugin --workspaces --if-present",
    "validate:release-metadata": "node scripts/validate-release-metadata.mjs",
    "validate:submission": "node scripts/validate-submission-pack.mjs",
    "validate:registry": "npm run validate:registry --workspaces --if-present",
    "verify:reproducibility": "npm run verify:reproducibility --workspaces --if-present",
    "verify:docs": "npm run verify:docs --workspaces --if-present",
    "verify": "npm run check && npm run validate:plugin && npm run test:coverage && npm run build && npm run verify:reproducibility && npm run smoke:mcp && npm run smoke:skills"
  },
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript-eslint": "8.69.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
